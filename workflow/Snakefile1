from pathlib import Path
import pandas as pd

# Global paths
out_dir = Path(config['out_dir'])
logs = Path(config['log_dir'])

rule all:
    input:
        vcf_file=out_dir / "preimputation/final_processed.sorted.cleaned.reheadered.vcf",
        psam=out_dir / "plink/plink.psam",
        pgen=out_dir / "plink/plink.pgen",
        pvar=out_dir / "plink/plink.pvar"

rule process_vcf:
    input:
        vcf=config['input_vcf']
    output:
        processed_vcf=temp(out_dir / "preimputation/final_processed.vcf")
    log:
        logs / "preimputation/process_vcf.log"
    conda:
        "../env/pysam.yaml"
    script:
        "../scripts/process_vcf.R"

rule sort_vcf:
    input:
        vcf=out_dir / "preimputation/final_processed.vcf"
    output:
        sorted_vcf=temp(out_dir / "preimputation/final_processed.sorted.vcf")
    log:
        logs / "preimputation/sort_vcf.log"
    shell:
        """
        bcftools sort -o {output.sorted_vcf} {input.vcf} > {log} 2>&1
        """

rule remove_unknowns:
    input:
        vcf=out_dir / "preimputation/final_processed.sorted.vcf"
    output:
        cleaned_vcf=out_dir / "preimputation/final_processed.sorted.cleaned.vcf"
    log:
        logs / "preimputation/remove_unknowns.log"
    shell:
        """
        sed -e '/UNKNOWNPOSITION/d' {input.vcf} > {output.cleaned_vcf}
        """

rule vcf_reheader:
    input:
        vcf=out_dir / "preimputation/final_processed.sorted.cleaned.vcf"
    output:
        reheadered_vcf=out_dir / "preimputation/final_processed.sorted.cleaned.reheadered.vcf"
    params:
        fai="resources/genomes/refdata-cellranger-GRCh38-3.0.0/fasta/genome.fa.fai"
    log:
        logs / "preimputation/vcf_reheader.log"
    shell:
        """
        bcftools reheader -f {params.fai} {input.vcf} -o {output.reheadered_vcf} > {log} 2>&1
        """

rule generate_sample_psam:
    input:
        vcf=out_dir / "preimputation/final_processed.sorted.cleaned.reheadered.vcf"
    output:
        psam=out_dir / "metadata/metadata.psam"
    log:
        logs / "metadata/generate_sample_psam.log"
    conda:
        "../envs/pysam.yaml"
    script:
        "../scripts/generate_sample_psam.py"

rule run_plink:
    input:
        psam=out_dir / "metadata/metadata.psam",
        vcf=out_dir / "preimputation/final_processed.sorted.cleaned.reheadered.vcf"
    output:
        psam=out_dir / "plink/plink.psam",
        pgen=out_dir / "plink/plink.pgen",
        pvar=out_dir / "plink/plink.pvar"
    params:
        plink_prefix=out_dir / "plink/plink"
    log:
        logs / "plink/run_plink.log"
    container:
        config["container"]
    shell:
        """
        plink2 \
        --vcf {input.vcf} \
        --make-pgen 'psam-cols=fid,parents,sex,phenos' \
        --out {params.plink_prefix} \
        --psam {input.psam} \
        --sort-vars > {log} 2>&1
        """
